{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cancharclub",
  "main": "worker-entry.js",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cancharclub"
    }
  ],
  "triggers": {
    "crons": [
      "0 4 * * *",
      "0 6 * * *",
      "0 10 * * *",
      "0 12 * * *",
      "0 18 * * *"
    ]
  },
